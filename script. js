const DEBOUNCE_MS = 3000; // <-- YOUR REQUEST: 3 seconds live

const debounce = (fn, delay) => { let t; return (...a) => { clearTimeout(t); t=setTimeout(()=>fn(...a),delay);} };
const checkCriteria = (pwd) => ({length:pwd.length>=8,upper:/[A-Z]/.test(pwd),lower:/[a-z]/.test(pwd),number:/\d/.test(pwd),special:/[^A-Za-z0-9]/.test(pwd)});
const calcScore = (pwd,c) => { if(!pwd) return 0; let s=Math.min(pwd.length*4,40); if(c.upper)s+=10; if(c.lower)s+=10; if(c.number)s+=15; if(c.special)s+=20; if(c.length&&c.upper&&c.lower&&c.number&&c.special)s+=5; return Math.min(s,100); };
const calcEntropy = (pwd) => { let p=0; if(/[a-z]/.test(pwd))p+=26; if(/[A-Z]/.test(pwd))p+=26; if(/\d/.test(pwd))p+=10; if(/[^A-Za-z0-9]/.test(pwd))p+=32; return p?Math.round(pwd.length*Math.log2(p)):0; };
const estimateCrackTime = (e) => { const s=Math.pow(2,e)/1e10; if(s<1)return"Instant"; if(s<60)return`${Math.round(s)}s`; if(s<3600)return`${Math.round(s/60)}m`; if(s<86400)return`${Math.round(s/3600)}h`; if(s<31536000)return`${Math.round(s/86400)}d`; return`${Math.round(s/31536000)}y`; };
const getColor = (s) => s<30?"var(--bad)":s<60?"var(--warn)":"var(--neon)";

const el = {pwd:document.getElementById('pwd'),meter:document.getElementById('meter'),score:document.getElementById('score'),crack:document.getElementById('crack'),entropy:document.getElementById('entropy'),len:document.getElementById('len'),criteria:document.getElementById('criteria'),dot:document.getElementById('dot'),status:document.getElementById('statusTxt')};

function analyzePassword(pwd){ const c=checkCriteria(pwd); return{criteria:c,score:calcScore(pwd,c),entropy:calcEntropy(pwd),length:pwd.length}; }
function updateUI(pwd){ const r=analyzePassword(pwd); el.meter.style.width=r.score+"%"; el.meter.style.background=getColor(r.score); el.score.textContent=r.score+" / 100"; el.entropy.textContent=r.entropy+" bits"; el.len.textContent=r.length; el.crack.textContent=pwd?estimateCrackTime(r.entropy):"-"; el.criteria.innerHTML=Object.entries({"8+ chars":r.criteria.length,"Uppercase A-Z":r.criteria.upper,"Lowercase a-z":r.criteria.lower,"Number 0-9":r.criteria.number,"Special !@#":r.criteria.special}).map(([k,v])=>`<div class="crit ${v?'ok':''}"><span>${k}</span><span>${v?'✓':'×'}</span></div>`).join(''); el.dot.classList.toggle('active',pwd.length>0); el.status.textContent=pwd?`Live (${r.score}%) - updated after 3s idle`:"Live - type to analyze"; }

const debouncedUpdate = debounce((v)=>updateUI(v), DEBOUNCE_MS);
el.pwd.addEventListener('input',(e)=>{ const v=e.target.value; if(v.length===1) updateUI(v); el.status.textContent="Typing... waiting 3s"; el.dot.classList.remove('active'); debouncedUpdate(v); });
document.getElementById('toggle').onclick=()=>{ el.pwd.type=el.pwd.type==='password'?'text':'password'; };
updateUI(""); 